    },
    {
      "claim": "scLDL beats kNN on discovery AUROC of 1-p(given)",
      "hippo": true,
      "lymphnode": true,
      "note": "LN uniform 30% gap is small (0.602 vs 0.587). Similar-type: kNN falls to or below chance; scLDL stays slightly above."
    },
    {
      "claim": "Entropy and vacuity AUROC stay near 0.5 and do not discover flips",
      "hippo": true,
      "lymphnode": true
    },
    {
      "claim": "Similar-type swaps are harder to discover than uniform flips",
      "hippo": true,
      "lymphnode": true,
      "note": "LN uniform AUROC ~0.60-0.62 vs similar ~0.51-0.59."
